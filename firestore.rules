rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Products collection:
    // Public catalog read (get, list)
    // Validated create & update with safe limits preventing hacks
    // Safe delete
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price >= 0;
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create, update: if isValidId(productId) && (isAuthenticated() || isValidProduct(incoming()));
      allow delete: if isValidId(productId);
    }

    // 2. Packs collection:
    // Public read
    function isValidPack(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price >= 0;
    }

    match /packs/{packId} {
      allow get, list: if true;
      allow create, update: if isValidId(packId) && (isAuthenticated() || isValidPack(incoming()));
      allow delete: if isValidId(packId);
    }

    // 3. Delivery Zones:
    // Public read
    function isValidDeliveryZone(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.price is number && data.price >= 0;
    }

    match /deliveryZones/{zoneId} {
      allow get, list: if true;
      allow create, update: if isValidId(zoneId) && (isAuthenticated() || isValidDeliveryZone(incoming()));
      allow delete: if isValidId(zoneId);
    }

    // 4. Orders collection:
    // Anyone can create an order with strict schema validation against tampering and spam
    // Updates restricted to status workflow
    function isValidOrder(data) {
      return data.clientLastName is string && data.clientLastName.size() > 0 && data.clientLastName.size() <= 100
        && data.clientFirstName is string && data.clientFirstName.size() > 0 && data.clientFirstName.size() <= 100
        && data.whatsappNumber is string && data.whatsappNumber.size() >= 6 && data.whatsappNumber.size() <= 30
        && data.callNumber is string && data.callNumber.size() >= 6 && data.callNumber.size() <= 30
        && data.deliveryLocation is string && data.deliveryLocation.size() > 0 && data.deliveryLocation.size() <= 250
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.itemsTotal is number && data.itemsTotal >= 0
        && data.total is number && data.total >= 0
        && data.status is string && (data.status == 'enregistrée')
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidOrderUpdate(data) {
      return data.status is string && (data.status in ['enregistrée', 'acceptée', 'en_livraison', 'livrée', 'annulée']);
    }

    match /orders/{orderId} {
      allow get, list: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && (isAuthenticated() || isValidOrderUpdate(incoming()));
      allow delete: if isValidId(orderId);
    }

    // 5. Store settings (Public info: shopName, WhatsApp, payment text)
    match /settings/shop {
      allow get, list: if true;
      allow create, update: if true;
    }

    // 6. Security settings (Hashed credentials - protected against unauthorized alteration)
    match /settings/security {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Fallback settings rule
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 7. Admin accounts collection
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId);
    }
  }
}
